    
    # Zamanlayıcıyı başlatıyoruz
    baslangic = time.time()
    
    print(f"\n[*] {hedef} için tarama başlatıldı... Lütfen bekleyin.")
    
    try:
        # Seçime göre nmap argümanlarını belirliyoruz
        if secim == "1":
            nm.scan(hedef, arguments='-sV')
        elif secim == "2":
            nm.scan(hedef, arguments='-sn')
        elif secim == "3":
            nm.scan(hedef, arguments='-O')

        # Zamanı hesaplıyoruz
        bitis = time.time()
        sure = round(bitis - baslangic, 2)

        print(f"[+] Tarama tamamlandı! Süre: {sure} saniye.")
        
        for host in nm.all_hosts():
            print(f"\nCihaz: {host} ({nm[host].hostname()})")
            print(f"Durum: {nm[host].state()}")

    except Exception as e:
        print(f"[-] Bir hata oluştu: {e}")

def ana_menu():
    while True:
        print("\n=== Gelişmiş Nmap Analiz Aracı ===")
        print("1- Servis Versiyon Tespiti (-sV)")
        print("2- Hızlı Cihaz Keşfi (Ping Scan)")
        print("3- İşletim Sistemi Analizi (-O)")
        print("4- Çıkış")
        
        secim = input("\nSeçiminiz: ")
        if secim == "4":
            break
            
        hedef = input("Hedef IP veya Domain (Örn: 192.168.1.1 veya google.com): ")
        nmap_calistir(hedef, secim)

if __name__ == "__main__":
    ana_menu()
